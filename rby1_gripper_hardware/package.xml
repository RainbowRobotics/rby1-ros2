<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rby1_gripper_hardware</name>
  <version>0.2.0</version>
  <description>
    ros2_control system interface for the RB-Y1 grippers: the RB gripper (one Dynamixel per gripper on
    the UPC serial port, driven with rby1-sdk's DynamixelBus) and a fake backend for tests.
  </description>
  <maintainer email="jinseok.kim970@gmail.com">Jinseok Kim</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Also needs the rby1-sdk C++ library, which has no rosdep key:
       install it with scripts/install_rby1_sdk.sh (see README). -->

  <depend>eigen</depend>
  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
