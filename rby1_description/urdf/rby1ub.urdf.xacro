<?xml version="1.0"?>
<robot name="rby1ub" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    Top-level wrapper for the RBY1 upper-body (UB) platform.
    Single variant; vendored from rby1-sdk/models/rby1ub/urdf/model.urdf.
  -->
  <xacro:arg name="robot_ip" default="192.168.30.1:50051"/>
  <xacro:arg name="use_mock_hardware" default="false"/>
  <!-- sdk: real robot or rby1 simulator core; fake: in-memory robot for tests -->
  <xacro:arg name="backend" default="sdk"/>
  <xacro:arg name="auto_enable" default="false"/>
  <xacro:arg name="command_rate" default="100"/>
  <xacro:arg name="state_rate" default="200"/>
  <xacro:arg name="impedance" default="true"/>
  <xacro:arg name="task_space" default="true"/>
  <!-- SDK real-time control (UDP, 2 ms): exports effort and feedback_gain command interfaces -->
  <xacro:arg name="realtime" default="false"/>
  <xacro:arg name="gripper" default="false"/>
  <xacro:arg name="gripper_backend" default="rb_dynamixel"/>
  <xacro:arg name="gripper_device" default="/dev/rby1_gripper"/>

  <xacro:include filename="$(find rby1_description)/urdf/rby1ub/model.xacro"/>
  <xacro:include filename="$(find rby1_description)/urdf/rby1.ros2_control.xacro"/>
  <xacro:include filename="$(find rby1_description)/urdf/rby1_gripper.ros2_control.xacro"/>

  <xacro:rby1ub_ros2_control
    robot_ip="$(arg robot_ip)"
    use_mock_hardware="$(arg use_mock_hardware)"
    backend="$(arg backend)"
    auto_enable="$(arg auto_enable)"
    command_rate="$(arg command_rate)"
    state_rate="$(arg state_rate)"
    impedance="$(arg impedance)"
    task_space="$(arg task_space)"
    realtime="$(arg realtime)"/>

  <xacro:if value="$(arg gripper)">
    <xacro:rby1_gripper_ros2_control
      robot_ip="$(arg robot_ip)"
      model="ub"
      use_mock_hardware="$(arg use_mock_hardware)"
      backend="$(arg gripper_backend)"
      device="$(arg gripper_device)"/>
  </xacro:if>
</robot>
